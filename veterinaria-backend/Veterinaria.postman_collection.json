{
  "info": {
    "name": "Veterinaria · Semana 10",
    "description": "Ejecutar en orden. POST guarda el ID y DELETE elimina solo la mascota creada por esta colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "mascota_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 · Comprobar conexión",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Obtener mascotas",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/mascotas",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "mascotas"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 · Crear mascota",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/mascotas",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "mascotas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombres\": \"Luna (Postman)\",\n  \"genero\": \"Hembra\",\n  \"raza\": \"Labrador\",\n  \"fecha_nacimiento\": \"2023-05-10\",\n  \"especie\": \"Perro\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"mascota_id\", pm.response.json().id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "04 · Obtener mascota creada",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/mascotas/{{mascota_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "mascotas",
            "{{mascota_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });",
              "pm.test(\"ID correcto\", function () { pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"mascota_id\"))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 · Actualizar mascota",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/mascotas/{{mascota_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "mascotas",
            "{{mascota_id}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombres\": \"Luna actualizada (Postman)\",\n  \"genero\": \"Hembra\",\n  \"raza\": \"Mestiza\",\n  \"fecha_nacimiento\": \"2023-05-10\",\n  \"especie\": \"Perro\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });",
              "pm.test(\"Nombre actualizado\", function () { pm.expect(pm.response.json().nombres).to.eql(\"Luna actualizada (Postman)\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 · Borrar mascota de prueba",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/mascotas/{{mascota_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "mascotas",
            "{{mascota_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Mensaje de eliminación\", function () { pm.expect(pm.response.json().mensaje).to.eql(\"Mascota eliminada correctamente.\"); });",
              "pm.test(\"ID eliminado\", function () { pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"mascota_id\"))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 · Verificar que fue borrada",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/mascotas/{{mascota_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "mascotas",
            "{{mascota_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP 404\", function () { pm.response.to.have.status(404); });",
              "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });"
            ]
          }
        }
      ]
    }
  ]
}
